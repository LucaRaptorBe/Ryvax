// VisualPositionManager.cs - Orchestrates visual position calculation (V4.0 Pure LoL)
// visualPos = basePos (NO offset, NO prediction)
// Coordinates TimeSync and BaseInterpolator
//
// V4.0 Changes:
// - Removed VisualOffsetCorrector entirely
// - Removed AbsorbBasePosJump (was for prediction model)
// - visualPos = basePos directly (pure server authority)
// - Kept CC tracking for IntentBuilder

using UnityEngine;
using MOBANet.Client.Timing;
using MOBANet.Client.Interpolation;
using MOBANet.Shared;

namespace MOBANet.Client.Prediction
{
    /// <summary>
    /// Orchestrates the visual position system (V4.0 Pure LoL).
    ///
    /// Key formula: visualPos = basePos (no offset!)
    ///
    /// Components:
    /// - TimeSync: Manages PLL timing and adaptive buffer
    /// - BaseInterpolator: Interpolates basePos from snapshots
    ///
    /// Flow each frame:
    /// 1. TimeSync provides renderTime (serverTime - adaptiveBuffer)
    /// 2. BaseInterpolator calculates basePos at renderTime
    /// 3. visualPos = basePos (direct, no offset)
    /// </summary>
    public class VisualPositionManager
    {
        private readonly TimeSync _timeSync;
        private readonly BaseInterpolator _interpolator;

        // Current state
        private Vector3 _basePos;
        private float _baseRotY;
        private float _currentSpeed;
        private bool _initialized;
        private bool _isImmobilized;

        /// <summary>
        /// The visual position to render.
        /// V4.0: Directly equals basePos (no offset).
        /// </summary>
        public Vector3 VisualPosition => _basePos;

        /// <summary>
        /// Visual rotation Y (degrees).
        /// </summary>
        public float VisualRotationY => _baseRotY;

        /// <summary>
        /// Base position from interpolation.
        /// V4.0: Same as VisualPosition.
        /// </summary>
        public Vector3 BasePosition => _basePos;

        /// <summary>
        /// Current player speed from latest snapshot.
        /// </summary>
        public float CurrentSpeed => _currentSpeed;

        /// <summary>
        /// Current adaptive buffer in seconds.
        /// </summary>
        public float AdaptiveBuffer => _timeSync.AdaptiveBuffer;

        /// <summary>
        /// Whether the manager has received at least one snapshot.
        /// </summary>
        public bool IsInitialized => _initialized;

        /// <summary>
        /// Whether entity is currently under immobilizing CC.
        /// IntentBuilder should check this to suppress movement intents.
        /// </summary>
        public bool IsImmobilized => _isImmobilized;

        /// <summary>
        /// Current render time (server time - buffer).
        /// </summary>
        public float RenderTime => _timeSync.RenderTime;

        /// <summary>
        /// Current base position quality.
        /// Interpolated = normal, Extrapolated = dead-reckoning, Frozen = no data.
        /// </summary>
        public BasePosQuality Quality => _interpolator.Quality;

        /// <summary>
        /// Create VisualPositionManager with external TimeSync (from NetworkClient).
        /// </summary>
        /// <param name="timeSync">Shared TimeSync from NetworkClient</param>
        public VisualPositionManager(TimeSync timeSync)
        {
            _timeSync = timeSync;
            _interpolator = new BaseInterpolator();
        }

        /// <summary>
        /// Call when a snapshot is received from the server.
        /// </summary>
        /// <param name="state">Snapshot state</param>
        /// <param name="serverTime">Server time of this snapshot</param>
        public void OnSnapshotReceived(SnapshotState state, float serverTime)
        {
            // Add to interpolation buffer
            _interpolator.OnSnapshotReceived(state, serverTime);

            // Extract info from snapshot
            _currentSpeed = state.Speed;

            // Track CC immobilization (for IntentBuilder)
            _isImmobilized = state.HasImmobilizeCC;

            // Handle teleport/blink events - just reset interpolator
            if (state.HasBlinkEvent || state.HasTeleportEvent || state.HasStateReset)
            {
                _interpolator.PurgeSnapshotsBefore(serverTime);
            }

            _initialized = true;
        }

        /// <summary>
        /// Update visual position. Call every frame.
        /// V4.0: Simply reads basePos from interpolator.
        /// </summary>
        /// <param name="dt">Delta time (unused, kept for API compatibility)</param>
        public void Update(float dt)
        {
            if (!_initialized) return;

            // INTERPOLATION DISABLED: Use latest snapshot position directly
            // Note: BaseInterpolator.GetBasePos already handles this, but we call it anyway
            // for consistency. The interpolator will return the latest snapshot.
            float renderTime = _timeSync.RenderTime;

            // Get interpolated position from server snapshots
            // (When INTERPOLATION_DISABLED, this returns latest snapshot directly)
            _basePos = _interpolator.GetBasePos(renderTime);
            _baseRotY = _interpolator.GetBaseRotationY(renderTime);

            // V4.0: No absorb, no decay, no offset
            // visualPos = basePos directly
        }

        /// <summary>
        /// Force teleport to a position.
        /// </summary>
        public void Teleport(Vector3 position, float rotationY)
        {
            _basePos = position;
            _baseRotY = rotationY;
            _interpolator.Reset();
        }

        /// <summary>
        /// Reset all state.
        /// </summary>
        public void Reset()
        {
            _interpolator.Reset();
            _basePos = Vector3.zero;
            _baseRotY = 0;
            _currentSpeed = 0;
            _initialized = false;
            _isImmobilized = false;
        }

        /// <summary>
        /// Get debug info string.
        /// </summary>
        public string GetDebugInfo()
        {
            return $"VisualPos: pos={_basePos:F1} rot={_baseRotY:F1} speed={_currentSpeed:F1} quality={Quality} immob={_isImmobilized}";
        }
    }
}
