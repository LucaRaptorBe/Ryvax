// NetcodeDebugLog.cs - DISABLED (V4.0)
// Re-enable by removing #if false / #endif

#if false

// NetcodeDebugLog.cs - Debug logging for LoL-style netcode V4.0 Pure LoL
// Attach to any GameObject to see netcode events in real-time
//
// V4.0 Changes:
// - Removed offset/absorb tracking (no longer used in Pure LoL model)
// - Simplified to: quality + position + buffer stats

using UnityEngine;
using MOBANet.UnityView.Core;
using MOBANet.Client.Interpolation;

namespace MOBANet.Diagnostics
{
    public class NetcodeDebugLog : MonoBehaviour
    {
        [Header("What to Log")]
        public bool LogMovement = true;          // Position changes
        public bool LogQualityChanges = true;    // Interp/Extrap/Frozen
        public bool LogStats = true;             // Periodic summary

        [Header("Settings")]
        public float StatsInterval = 3f;
        public float MovementLogInterval = 0.5f; // Don't spam every frame

        private NetworkClient _client;
        private BasePosQuality _lastQuality;
        private Vector3 _lastPosition;
        private float _statsTimer;
        private float _movementLogTimer;

        // Stats
        private int _interpFrames, _extrapFrames, _frozenFrames;

        void Start()
        {
            _client = FindFirstObjectByType<NetworkClient>();
            if (_client == null)
            {
                UnityEngine.Debug.LogWarning("[Netcode] NetworkClient not found!");
                enabled = false;
            }
            else
            {
                UnityEngine.Debug.Log("[Netcode] V4.0 Pure LoL debug logging enabled.");
            }
        }

        void Update()
        {
            if (_client == null || !_client.IsConnected || _client.LocalEntityId == 0) return;

            var quality = _client.GetBasePosQuality();
            var position = _client.GetVisualPosition();
            var speed = _client.GetCurrentSpeed();

            // === Quality changes ===
            if (LogQualityChanges && quality != _lastQuality)
            {
                string icon = quality switch
                {
                    BasePosQuality.Interpolated => "OK",
                    BasePosQuality.Extrapolated => "EXTRAP",
                    BasePosQuality.Frozen => "FROZEN",
                    _ => "?"
                };
                UnityEngine.Debug.Log($"[Netcode] Quality: {icon} (was {_lastQuality})");
                _lastQuality = quality;
            }

            // === Movement logging (periodic) ===
            _movementLogTimer += Time.deltaTime;
            if (LogMovement && _movementLogTimer >= MovementLogInterval)
            {
                _movementLogTimer = 0;

                if (speed > 0.1f)
                {
                    UnityEngine.Debug.Log($"[Netcode] Pos: {position:F1} speed={speed:F0} quality={quality}");
                }
            }

            // === Stats tracking ===
            switch (quality)
            {
                case BasePosQuality.Interpolated: _interpFrames++; break;
                case BasePosQuality.Extrapolated: _extrapFrames++; break;
                case BasePosQuality.Frozen: _frozenFrames++; break;
            }

            _lastPosition = position;

            // === Stats summary ===
            _statsTimer += Time.deltaTime;
            if (LogStats && _statsTimer >= StatsInterval)
            {
                LogStatsSummary();
                ResetStats();
            }
        }

        void LogStatsSummary()
        {
            int total = _interpFrames + _extrapFrames + _frozenFrames;
            if (total == 0) return;

            float interpPct = 100f * _interpFrames / total;
            float extrapPct = 100f * _extrapFrames / total;
            float buffer = _client.GetAdaptiveBuffer() * 1000f;

            string status = "";
            if (extrapPct > 10f) status += " [!EXTRAP]";

            UnityEngine.Debug.Log($"[Netcode] === STATS === " +
                $"Interp:{interpPct:F0}% Extrap:{extrapPct:F0}% | " +
                $"Buffer:{buffer:F0}ms{status}");
        }

        void ResetStats()
        {
            _interpFrames = _extrapFrames = _frozenFrames = 0;
            _statsTimer = 0;
        }

        void OnGUI()
        {
            if (_client == null || !_client.IsConnected || _client.LocalEntityId == 0) return;

            var quality = _client.GetBasePosQuality();
            var position = _client.GetVisualPosition();
            var speed = _client.GetCurrentSpeed();
            var buffer = _client.GetAdaptiveBuffer() * 1000f;
            bool hasIntent = _client.HasLocalMoveIntent();

            // Color based on state
            Color qualityColor = quality switch
            {
                BasePosQuality.Interpolated => Color.green,
                BasePosQuality.Extrapolated => Color.yellow,
                BasePosQuality.Frozen => Color.red,
                _ => Color.white
            };

            GUIStyle style = new GUIStyle(GUI.skin.box);
            GUIStyle labelStyle = new GUIStyle(GUI.skin.label) { fontSize = 12 };

            GUI.Box(new Rect(10, 10, 280, 110), "");
            GUILayout.BeginArea(new Rect(15, 15, 270, 100));

            GUILayout.Label("<b>LoL Netcode V4.0 Pure</b>", new GUIStyle(labelStyle) { richText = true, fontSize = 14 });

            GUI.color = qualityColor;
            GUILayout.Label($"Quality: {quality}", labelStyle);
            GUI.color = Color.white;

            GUILayout.Label($"Speed: {speed:F1} | Buffer: {buffer:F0}ms", labelStyle);
            GUILayout.Label($"Position: ({position.x:F1}, {position.y:F1}, {position.z:F1})", labelStyle);
            GUILayout.Label($"Local Intent: {(hasIntent ? "Moving" : "Idle")}", labelStyle);

            GUILayout.EndArea();
        }
    }
}

#endif
