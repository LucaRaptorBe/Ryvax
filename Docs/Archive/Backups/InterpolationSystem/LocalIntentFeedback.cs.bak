// LocalIntentFeedback.cs - Immediate visual feedback for local player input (V4.0)
//
// Purpose: Provides instant rotation and animation feedback when the player
// inputs movement, without waiting for server confirmation.
//
// This is the "Pure LoL" approach:
// - Position = server authority (interpolated, ~66ms latency)
// - Rotation = local intent (immediate, 0ms latency)
// - Animation = local intent (immediate, 0ms latency)

using System;
using UnityEngine;

namespace MOBANet.Client.Input
{
    /// <summary>
    /// Manages local move intent for immediate visual feedback.
    ///
    /// When enabled:
    /// - Rotation follows input direction immediately
    /// - Animation triggers immediately on input
    ///
    /// When disabled:
    /// - Rotation follows server (delayed ~66ms)
    /// - Animation follows server velocity (delayed ~66ms)
    /// </summary>
    [Serializable]
    public class LocalIntentFeedback
    {
        [Header("Settings")]
        [Tooltip("Enable immediate rotation/animation feedback based on local input")]
        [SerializeField] private bool _enabled = true;

        [Tooltip("Rotation smoothing speed (degrees per second factor)")]
        [SerializeField] [Range(5f, 30f)] private float _rotationSpeed = 15f;

        // Runtime state (not serialized)
        private Vector3 _intentDirection;
        private bool _hasIntent;

        /// <summary>
        /// Whether local intent feedback is enabled.
        /// When disabled, rotation/animation use server values instead.
        /// </summary>
        public bool Enabled
        {
            get => _enabled;
            set => _enabled = value;
        }

        /// <summary>
        /// Rotation smoothing speed factor.
        /// Used as: LerpAngle(current, target, dt * RotationSpeed)
        /// </summary>
        public float RotationSpeed => _rotationSpeed;

        /// <summary>
        /// Whether there is an active local move intent.
        /// Returns false if feedback is disabled.
        /// </summary>
        public bool HasIntent => _enabled && _hasIntent;

        /// <summary>
        /// Current intent direction (normalized).
        /// Returns zero if no intent or feedback is disabled.
        /// </summary>
        public Vector3 Direction => (_enabled && _hasIntent) ? _intentDirection : Vector3.zero;

        /// <summary>
        /// Set the local move intent direction.
        /// Called by InputCollector when player inputs movement.
        /// </summary>
        /// <param name="direction">Movement direction in world space (will be normalized)</param>
        public void SetIntent(Vector3 direction)
        {
            if (!_enabled) return;

            _intentDirection = direction.sqrMagnitude > 0.001f
                ? direction.normalized
                : Vector3.zero;
            _hasIntent = _intentDirection.sqrMagnitude > 0.001f;
        }

        /// <summary>
        /// Clear the local move intent.
        /// Called by InputCollector when player stops inputting movement.
        /// </summary>
        public void ClearIntent()
        {
            _hasIntent = false;
            _intentDirection = Vector3.zero;
        }

        /// <summary>
        /// Calculate target rotation Y based on intent direction.
        /// Returns null if no intent or feedback is disabled.
        /// </summary>
        public float? GetTargetRotationY()
        {
            if (!_enabled || !_hasIntent || _intentDirection.sqrMagnitude < 0.001f)
                return null;

            return Mathf.Atan2(_intentDirection.x, _intentDirection.z) * Mathf.Rad2Deg;
        }

        /// <summary>
        /// Calculate smoothed rotation towards intent direction.
        /// </summary>
        /// <param name="currentRotY">Current rotation Y in degrees</param>
        /// <param name="dt">Delta time</param>
        /// <returns>Smoothed rotation Y, or currentRotY if no intent</returns>
        public float GetSmoothedRotationY(float currentRotY, float dt)
        {
            float? targetRotY = GetTargetRotationY();
            if (!targetRotY.HasValue)
                return currentRotY;

            // INTERPOLATION DISABLED: Return target rotation directly (no lerp)
            if (MOBANet.Shared.NetcodeConstants.INTERPOLATION_DISABLED)
            {
                return targetRotY.Value;
            }

            return Mathf.LerpAngle(currentRotY, targetRotY.Value, dt * _rotationSpeed);
        }

        /// <summary>
        /// Reset all state.
        /// </summary>
        public void Reset()
        {
            _hasIntent = false;
            _intentDirection = Vector3.zero;
        }
    }
}
